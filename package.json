{
  "name": "r-prison-designer",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "start": "electron .",
    "test:smoke": "npm run build && node scripts/prison03-smoke.mjs",
    "test:prison-smoke": "npm run build && node scripts/prison03-smoke.mjs",
    "test:ui": "npm run build && node scripts/library-smoke.mjs",
    "test:play": "npm run build && node scripts/play-smoke.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^41.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
